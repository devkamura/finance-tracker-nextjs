# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance_tracker"

# Auth.js (NextAuth v5)
AUTH_SECRET=""                     # `openssl rand -base64 32` 等で生成
AUTH_URL="http://localhost:3000"   # staging/prodではデプロイ先ドメインに変更

# Google OAuth（ログイン & Google Drive 共用）
# Google Cloud Console でOAuthクライアントを作成し、
# 承認済みリダイレクトURIに `{AUTH_URL}/api/auth/callback/google` を登録すること。
# OAuth同意画面のスコープに `.../auth/drive.file` の追加も必要。
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Drive アップロード先フォルダID
GDRIVE_FOLDER_ID=""

# docker-compose用（開発）
POSTGRES_DB=finance_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
