# Supabase
# ローカル値は `supabase start` 後に `supabase status` で確認できる。
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:55321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# service_role keyはサーバー専用の機密情報。NEXT_PUBLIC_を付けず、
# クライアントに送出されるコードから絶対にimportしないこと。
SUPABASE_SERVICE_ROLE_KEY=""

# アプリの公開URL（Supabase AuthのOAuthコールバックのredirectTo生成に使用）
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google OAuth（ログイン & Google Drive 共用）
# Google Cloud Console でOAuthクライアントを作成し、
# 承認済みリダイレクトURIに `{SUPABASE_URL}/auth/v1/callback` を登録すること
# （ローカルは `http://127.0.0.1:55321/auth/v1/callback`）。
# OAuth同意画面のスコープに `.../auth/drive.file` の追加も必要。
# これらの値はアプリのSupabase Auth設定（supabase/config.tomlのauth.external.google、
# 本番はSupabaseダッシュボード）でも同じ値を使用する。
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Drive アップロード先フォルダID
GDRIVE_FOLDER_ID=""

# Gemini API（レシート画像のOCR/情報抽出に使用）
# https://aistudio.google.com/apikey で発行できる。サーバー専用の機密情報のため
# NEXT_PUBLIC_を付けず、クライアントに送出されるコードから絶対にimportしないこと。
GEMINI_API_KEY=""
